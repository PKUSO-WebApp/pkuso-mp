# 复制为 .env.development / .env.production 并填入真实值
# 值来源：pkuso-web-v2/.env.local 的 NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# 注：anon key 为 publishable key（公开设计），但仍按 Web 端惯例不入库
TARO_APP_SUPABASE_URL=https://your-project.supabase.co
TARO_APP_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
# 会话诊断日志开关（1 开 / 0 关）
TARO_APP_SESSION_DIAG=0
